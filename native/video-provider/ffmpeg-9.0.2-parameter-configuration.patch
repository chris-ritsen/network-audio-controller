+static int decode_parameter_configuration(AVCodecContext *context, H264Context *decoder)
+{
+    const uint8_t *data = context->extradata;
+    int size = context->extradata_size;
+    int offset = 6;
+    int result = AVERROR_INVALIDDATA;
+    const SPS *sequence = NULL;
+    const PPS *picture = NULL;
+
+    if (!data || size < 11 || data[0] != 1 || data[4] != 255 || data[5] != 225)
+        return AVERROR_INVALIDDATA;
+
+    for (int index = 0; index < 2; index++) {
+        H2645Packet packet = { 0 };
+        H2645NAL *unit;
+        int length;
+
+        if (index == 1 && (offset >= size || data[offset++] != 1))
+            return AVERROR_INVALIDDATA;
+        if (size - offset < 2)
+            return AVERROR_INVALIDDATA;
+        length = AV_RB16(data + offset);
+        if (length < 2 || length > size - offset - 2 || length > 4096)
+            return AVERROR_INVALIDDATA;
+        if ((data[offset + 2] & 0x80) || !(data[offset + 2] & 0x60))
+            return AVERROR_INVALIDDATA;
+        result = ff_h2645_packet_split(&packet, data + offset, length + 2,
+                                      context, 2, AV_CODEC_ID_H264,
+                                      H2645_FLAG_IS_NALFF | H2645_FLAG_SMALL_PADDING);
+        if (result < 0)
+            goto release_packet;
+        result = AVERROR_INVALIDDATA;
+        if (packet.nb_nals != 1)
+            goto release_packet;
+        unit = &packet.nals[0];
+        if (unit->raw_size != length ||
+            unit->type != (index == 0 ? H264_NAL_SPS : H264_NAL_PPS))
+            goto release_packet;
+        if (index == 0) {
+            if (length < 4 || memcmp(data + 1, data + offset + 3, 3))
+                goto release_packet;
+            result = ff_h264_decode_seq_parameter_set(&unit->gb, context, &decoder->ps, 0);
+        } else {
+            result = ff_h264_decode_picture_parameter_set(&unit->gb, context,
+                                                          &decoder->ps, unit->size_bits);
+        }
+        if (result >= 0 && (get_bits_left(&unit->gb) != 0
+                           || unit->data[unit->size - 1] == 0))
+            result = AVERROR_INVALIDDATA;
+release_packet:
+        ff_h2645_packet_uninit(&packet);
+        if (result < 0)
+            return result;
+        offset += length + 2;
+    }
+    if (offset != size)
+        return AVERROR_INVALIDDATA;
+    for (int index = 0; index < MAX_SPS_COUNT; index++) {
+        if (decoder->ps.sps_list[index]) {
+            if (sequence)
+                return AVERROR_INVALIDDATA;
+            sequence = decoder->ps.sps_list[index];
+        }
+    }
+    for (int index = 0; index < MAX_PPS_COUNT; index++) {
+        if (decoder->ps.pps_list[index]) {
+            if (picture)
+                return AVERROR_INVALIDDATA;
+            picture = decoder->ps.pps_list[index];
+        }
+    }
+    if (!sequence || !picture || picture->sps != sequence || picture->sps_id != sequence->sps_id)
+        return AVERROR_INVALIDDATA;
+    decoder->parameter_configuration_width = sequence->mb_width * 16 - sequence->crop_left - sequence->crop_right;
+    decoder->parameter_configuration_height = sequence->mb_height * 16 - sequence->crop_top - sequence->crop_bottom;
+    if (decoder->parameter_configuration_width <= 0 || decoder->parameter_configuration_height <= 0)
+        return AVERROR_INVALIDDATA;
+    decoder->is_avc = 1;
+    decoder->nal_length_size = 4;
+    return 0;
+}
