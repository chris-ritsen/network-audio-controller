 static void
+gst_ffmpegviddec_check_parameter_configuration (GstFFMpegVidDec * ffmpegdec)
+{
+  gint64 accepted = 0;
+  gboolean revoked = FALSE;
+
+  if (!ffmpegdec->require_parameter_configuration)
+    return;
+  GST_OBJECT_LOCK (ffmpegdec);
+  if (ffmpegdec->context
+      && av_opt_get_int (ffmpegdec->context, "parameter_configuration_accepted",
+          AV_OPT_SEARCH_CHILDREN, &accepted) >= 0 && accepted == 1) {
+    GST_OBJECT_UNLOCK (ffmpegdec);
+    return;
+  }
+  revoked = ffmpegdec->parameter_configuration != NULL;
+  g_clear_pointer (&ffmpegdec->parameter_configuration, gst_structure_free);
+  GST_OBJECT_UNLOCK (ffmpegdec);
+  if (revoked)
+    g_object_notify (G_OBJECT (ffmpegdec), "parameter-configuration");
+}
